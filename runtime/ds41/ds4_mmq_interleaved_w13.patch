+// DS41 V4.1 resident GGUF layout: w13 stores [expert, gate_rows + up_rows, packed_K].
+// Reuse it in-place by widening only the per-expert row stride; arithmetic and
+// MMQ kernels are unchanged from the upstream paired IQ2_XXS path.
+extern "C" int ds4_mmq_iq2_xxs_moe_pair_interleaved_w13(
+        const void * W13, const float * X, const int32_t * ids,
+        float * out_gate, float * out_up,
+        int M, int K, int n_tokens, int n_experts, int n_expert_used,
+        cudaStream_t stream) {
+    if (!W13 || M <= 0 || K <= 0 || K % 256 != 0) return -1;
+    const int64_t s01 = (int64_t)K / ggml_blck_size(GGML_TYPE_IQ2_XXS);
+    const size_t gate_bank_offset = (size_t)M * (size_t)s01 * ggml_type_size(GGML_TYPE_IQ2_XXS);
+    const char * base = (const char *)W13;
+    return ds4_mmq_moe_pair_impl<GGML_TYPE_IQ2_XXS>(
+        "ds4_mmq_iq2_xxs_moe_pair_interleaved_w13",
+        base, base + gate_bank_offset, X, ids, out_gate, out_up,
+        M, K, n_tokens, n_experts, n_expert_used, stream,
+        nullptr, nullptr, 0, true, nullptr, true, 2 * M);
+}
