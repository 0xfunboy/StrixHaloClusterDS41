+def _torch_from_numpy_view(array: np.ndarray) -> torch.Tensor:
+    """Create a CPU tensor view without copying GGUF mmap-backed data.
+
+    GGUF tensors can be tens of GiB.  ``torch.tensor(array)`` eagerly clones
+    those bytes into anonymous RAM before the actual vLLM shard loader runs,
+    doubling the load peak.  The loader consumes each yielded tensor
+    synchronously and copies only its local shard to the target device, so a
+    read-only NumPy-backed view is the correct ownership boundary here.
+    """
+    if not array.flags.c_contiguous:
+        raise ValueError(f"GGUF tensor must be C-contiguous for zero-copy load: {array.shape}")
+    return torch.from_numpy(array)
+
