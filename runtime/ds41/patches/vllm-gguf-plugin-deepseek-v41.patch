         from . import fused_moe_gguf as fused_moe_gguf_op
 
+        # Under TP+expert-parallel vLLM stores complete experts locally and
+        # exposes a global->local map (-1 for experts owned by the peer).
+        # Keep the router's globally-normalized weights unchanged: each rank
+        # computes only its local contribution, remote routes are zero-weighted,
+        # and the normal TP all-reduce reconstructs the exact routed sum.
+        expert_map = layer.expert_map
+        if expert_map is not None:
+            local_ids = expert_map[topk_ids.to(torch.long)].to(topk_ids.dtype)
+            remote = local_ids < 0
+            topk_weights = topk_weights.masked_fill(remote, 0)
+            # GGUF kernels require in-range expert ids. Remote routes still run
+            # a harmless dummy expert with zero weight; this is deliberately a
+            # correctness-first baseline and can be optimized after qualification.
+            topk_ids = local_ids.clamp_min(0)
+
         return fused_moe_gguf_op(
             x,
             layer.w13_weight,
